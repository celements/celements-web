      <artifactId>jul-to-slf4j</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>jcl-over-slf4j</artifactId>
    </dependency>

    <!-- xwiki platform dependencies -->
    <!-- START xwiki-enterprise-web war -->
    <!-- START xwiki-web-standard war -->
