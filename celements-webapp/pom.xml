      <version>3.4.3.2-celRTE-b3-SNAPSHOT</version>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>com.celements</groupId>
      <artifactId>tinymce-langs-v4</artifactId>
      <type>war</type>
    </dependency>
    <dependency>
      <groupId>com.celements</groupId>
