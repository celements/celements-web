    </dependency>
    <!-- END xwiki-web-standard war -->
    <dependency>
      <groupId>com.celements</groupId>
      <artifactId>celements-scheduler</artifactId>
    </dependency>
    <dependency>
      <groupId>com.celements</groupId>
      <artifactId>celements-mailsender</artifactId>
