{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "src/presets/alu/index.js"],
  "exclude": ["test/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "isolatedModules": true,
    "lib": ["ES6", "ESNext", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
