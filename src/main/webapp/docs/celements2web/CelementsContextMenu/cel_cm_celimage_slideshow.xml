<property>
<cmi_link>#set($slideShowId = $origElemId.replaceFirst('slideContainer_', ''))
var imgSlideShow = CELEMENTS.image.getSlideShowObj("$slideShowId")._imageSlideShowObj;##
var animObj = imgSlideShow._slideShowAnimation;##
if (animObj.isStopped()) {##
animObj.startAnimation();##
myContextMenu.closeAll();##
alert("slideshow started");##
} else {##
animObj.stopAnimation();##
myContextMenu.closeAll();##
alert("slideshow stopped" + this.id);##
}##</cmi_link>
</property>
