    <name>Panels.GlobalRightsEditorWelcome</name>
    <number>0</number>
    <className>Panels.PanelClass</className>
    <guid>140b985b-2fe1-437e-9418-0dff1befcfe5</guid>
    <property>
      <category>Information</category>
    </property>
    <property>
      <content>#largepanelheader($msg.get("welcome"))
        &lt;div&gt;$msg.get("xe.panels.rights.welcomeglobal")&lt;/div&gt;
        &lt;div&gt;$msg.get("xe.panels.rights.space")&lt;/div&gt;
        &lt;div&gt;&lt;strong&gt;$msg.get("xe.panels.rights.warning")&lt;/strong&gt;
        $msg.get("xe.panels.rights.noauthentication")&lt;/div&gt;
        #if($xwiki.rightsmanager.defaultUi == "stable")
        &lt;form id="objectadd" method="post" action="$doc.getURL("objectadd")" onsubmit="cancelCancelEdit()"&gt;
        &lt;div class="centered padded"&gt;
        &lt;input type="hidden" name="xredirect" value="$xwiki.requestURL"/&gt;
        &lt;input type="hidden" name="classname" value="XWiki.XWikiGlobalRights"/&gt;
        &lt;input type="submit"
        value="$msg.get("addrightentry")" class="button"/&gt;
        &lt;/div&gt;
        &lt;/form&gt;
        #end
        #panelfooter()</content>
    </property>
    <property>
      <description>Global Rights Panel</description>
    </property>
    <property>
      <name>GlobalRightsEditorWelcome</name>
    </property>
