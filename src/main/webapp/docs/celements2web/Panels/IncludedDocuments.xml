    <name>Panels.IncludedDocuments</name>
    <number>0</number>
    <className>Panels.PanelClass</className>
    <guid>2a819388-3f6b-49a9-b4ba-de64119159bf</guid>
    <property>
      <category>Information</category>
    </property>
    <property>
      <content>#set($pages = $tdoc.includedPages)
        #if($pages.size() &gt; 0 || $showEmptyPanels)
        #largepanelheader($msg.get("xe.panels.document.information"))
        #if($pages.size() == 1)
        $xwiki.parseMessage("editincludepagemsgone"):
        #else
        $xwiki.parseMessage("editincludepagemsgmore"):
        #end
        &lt;ul&gt;
        #foreach ($page in $pages)
        &lt;li&gt;&lt;a href="$xwiki.getURL($page, 'view')"&gt;$page&lt;/a&gt;
        &lt;a
        href="$xwiki.getURL($page, 'edit')"&gt;&lt;img alt="$msg.get('panels.documentInformation.editIncluded',
        [$page])"
        src="$xwiki.getSkinFile('icons/silk/page_white_edit.gif')" /&gt;&lt;/a&gt;&lt;/li&gt;
        #end
        &lt;/ul&gt;
        &lt;/dd&gt;
        #panelfooter()
        #end</content>
    </property>
    <property>
      <description>Displays the documents included in the curent document.</description>
    </property>
    <property>
      <name>Included documents</name>
    </property>
    <property>
      <type>edit</type>
    </property>
