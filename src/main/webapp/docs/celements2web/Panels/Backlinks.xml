    <name>Panels.Backlinks</name>
    <number>0</number>
    <className>Panels.PanelClass</className>
    <guid>d653313b-41f2-478e-b66a-c5c51c0d0bda</guid>
    <property>
      <category>Information</category>
    </property>
    <property>
      <content>#set($blinks = $doc.getBacklinks())
        #if($blinks.size()&gt;0 || $showEmptyPanels)
        #panelheader($msg.get("docextra.backlinks"))
        #set($first = true)
        #foreach($docname in $blinks)
        #set($rdoc =
        $xwiki.getDocument($docname).getTranslatedDocument())
        #if($first == true)
        #set($first = false)
        #else
        &lt;span
        class="pitemseparator"&gt; | &lt;/span&gt;
        #end
        &lt;span class="panelitem"&gt;&lt;a
        href="$rdoc.getURL('view')"&gt;$xwiki.getXMLEncoded($rdoc.displayTitle)&lt;/a&gt;&lt;/span&gt;
        #end
        #panelfooter()
        #end
      </content>
    </property>
    <property>
      <description>List all pages having links to the page being viewed. Displays nothing if there are no links to the
        page being viewed.</description>
    </property>
    <property>
      <name>Backlinks</name>
    </property>
    <property>
      <type>view</type>
    </property>
